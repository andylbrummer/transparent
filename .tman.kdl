// Neither `stall` nor `max-cpu` is pinned here, and both omissions are deliberate.
//
// `stall` is a hang backstop, not a runtime budget: the scaffolded 60s fired 32 times across 959
// supervised runs and caught no actual hang, killing healthy work like a cold `go build ./...`.
// Omitting it takes tman's built-in 30m, and keeps taking whatever the corrected built-in is —
// writing 60s here is exactly what stopped these files inheriting that fix. Use `max-time` for a
// real deadline.
//
// `max-cpu` is normalised across all cores, so the scaffolded 95 meant "kill anything that
// saturates this machine" — which is what a healthy parallel build or threaded test run does.
//
// `max-mem` covers the whole tree, and it is the cap fleet-run's bare `tman run` gets, and the one
// tman's PATH shims give a nested `npm test`. Vitest runs one worker per core, so the suite's peak
// follows the host's core count. `npm test` (both workspaces), measured on the runners with the
// shims bypassed, tman 0.7.15, 2026-11-23:
//   build3, 32 cores: 4093, 4365, 5335, 5474 MB (runs culled at 2048 had reached 4791-5012 MB);
//     5710 MB through fleet-run after the cap was raised
//   beagle-ab, 12 cores: 2352, 2377, 2414 MB
// 7680 is the build3 peak plus 30%. A host with more cores needs a new measurement, not a guess.
defaults {
    max-mem 7680
    max-parallel 2
}

alias "test" {
    command "npm"
    args "run" "test"
}

alias "lint" {
    command "npm"
    args "run" "lint"
}


alias "build" {
    command "npm"
    args "run" "build"
    max-time "15m"
}

# Cloudflare Workers static assets (wrangler.jsonc). Everything else keeps
# Cloudflare's default, revalidate on every load; a header set by two
# matching rules would be joined with a comma, so Cache-Control is set once.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite fingerprints everything under assets/, so it never changes in place.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

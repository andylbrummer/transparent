{
  "id": "./",
  "name": "Transparent Earth",
  "short_name": "Transparent",
  "description": "Point your phone at the ground and see through the planet: the far side, the mantle and core, earthquakes and plates, and the sky below your feet.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#03050d",
  "theme_color": "#03050d",
  "categories": ["education", "science", "navigation"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Down through the Earth",
      "short_name": "Down through",
      "description": "From the ground under your feet to the inner core, 6,371 km straight down.",
      "url": "./?guide=down-through-the-earth",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "A night at the North Pole",
      "short_name": "North Pole",
      "description": "Stand at the pole on the longest night, and watch the stars circle without setting.",
      "url": "./?guide=a-night-at-the-north-pole",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {
      "src": "icons/screen-narrow.jpg",
      "sizes": "824x1830",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Looking down through the Earth at the far side, with plates and earthquakes"
    },
    {
      "src": "icons/screen-wide.jpg",
      "sizes": "1920x1080",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "The Mont Blanc skyline from Chamonix, with the far side of the Earth below the horizon"
    }
  ]

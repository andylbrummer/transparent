{
  "name": "transparent-earth",
  "private": true,
  "version": "0.1.0",
  "description": "Look down through the planet: a WebXR app that shows the Earth's interior, the far side and the sky beneath you, from real, cited data.",
  "license": "MIT",
  "author": "Andy Brummer",
  "homepage": "https://andylbrummer.github.io/transparent/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andylbrummer/transparent.git"
  },
  "bugs": "https://github.com/andylbrummer/transparent/issues",
  "keywords": ["earth", "webxr", "threejs", "geophysics", "seismology", "geology", "astronomy", "visualization", "open-data", "augmented-reality"],
  "type": "module",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "dev": "npm run dev -w app",
    "docs:sources": "npm run docs:sources -w app --"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  }
}
